APP_NAME="KosManager"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://kosan.my.id

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kosan_prod
DB_USERNAME=kosan_user
DB_PASSWORD=SecurePasswordHere

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=SecureRedisPassword
REDIS_PORT=6379
